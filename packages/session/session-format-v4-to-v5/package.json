{
  "name": "@deepseek-ai/dsh-session-format-v4-to-v5",
  "description": "V5 durable input admission and explicit conversion of local V4 Sessions",
  "version": "0.1.7-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/session/session-format-v4-to-v5"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "sessionFormatMigration": {
      "from": 4,
      "to": 5,
      "export": ".",
      "migration": "sessionFormatV4ToV5",
      "sourceCodec": "releasedV4SessionFormatCodec",
      "targetCodec": "v5SessionFormatCodec",
      "targetHeaderValidator": "assertV5Header",
      "targetRestorer": "restoreV5Artifact"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-session-format": "workspace:^",
    "@deepseek-ai/dsh-session-format-v2-to-v3": "workspace:^",
    "@deepseek-ai/dsh-session-format-v3-to-v4": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  }
}
