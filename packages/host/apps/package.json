{
  "name": "@deepseek-ai/dsh-host-apps",
  "version": "0.1.3-alpha.1",
  "description": "Registered local Web application launcher",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "license": "MIT",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./types": { "types": "./lib/types/types.d.ts", "default": "./lib/types/types.js" },
    "./remote": { "types": "./lib/typert.remote-client.d.ts", "default": "./lib/typert.remote-client.js" },
    "./typert": { "types": "./lib/typert.host.d.ts", "default": "./lib/typert.host.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "peerDependencies": { "@deepseek-ai/cordis": "workspace:^", "@deepseek-ai/dsh-typert-protocol": "workspace:^" },
  "dependencies": { "@deepseek-ai/schemastery": "workspace:^", "@deepseek-ai/dsh-settings": "workspace:^", "@deepseek-ai/dsh-subprocess": "workspace:^", "zod": "^4.4.3" },
  "devDependencies": { "@deepseek-ai/cordis": "workspace:^", "@deepseek-ai/dsh-typert-protocol": "workspace:^" },
  "files": ["lib/index.js", "lib/types/**/*.d.ts", "lib/typert.host.js", "lib/typert.host.d.ts", "lib/typert.remote-client.js", "lib/typert.remote-client.d.ts"]
}
