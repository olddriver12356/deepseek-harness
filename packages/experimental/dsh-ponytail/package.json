{
  "name": "@deepseek-ai/dsh-ponytail",
  "description": "Local adapter for ponytail's lazy-senior-dev ruleset, registered through DeepSeek Harness's own system-prompt seam",
  "version": "0.1.3-alpha.1",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
