    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-home-paths": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
